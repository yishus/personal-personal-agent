{
  "name": "personal-personal-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted personal AI agent with Telegram and HTTP interfaces on Cloudflare Workers",
  "keywords": [
    "agents",
    "ai",
    "cloudflare"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "start": "wrangler dev --config wrangler.jsonc",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "types": "wrangler types env.d.ts",
    "telegram:webhook": "node --env-file-if-exists=.dev.vars scripts/register-webhook.mjs",
    "format": "oxfmt --write .",
    "lint": "oxlint src/",
    "check": "oxfmt --check src scripts package.json tsconfig.json wrangler.jsonc README.md && oxlint src/ && tsc"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.129",
    "@cloudflare/codemode": "^0.5.4",
    "agents": "0.28.1",
    "ai": "^6.0.197",
    "croner": "^10.0.0",
    "workers-ai-provider": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "allowScripts": {
    "core-js-pure@3.49.0": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260721.1": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true
  }
}
